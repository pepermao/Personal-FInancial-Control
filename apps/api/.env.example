DATABASE_URL="postgresql://ledger:ledger@localhost:5434/ledger?schema=public"
PORT=3001
WEB_ORIGIN="http://localhost:5173"

# Pluggy / Open Finance (free Meu Pluggy personal tier)
# clientId + clientSecret come from dashboard.pluggy.ai -> your application.
# Banks are connected in-app (Configurações -> Open Finance) and stored in the
# pluggy_connections table, so no item IDs belong here.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

